# LARIS assistant settings (optional). Without them, Home answers common questions with
# labelled quick answers from LARIS's own calculations.
#
# Setup: copy this file to .streamlit/secrets.toml (git-ignored; never commit it),
# fill in your own key, then restart the app and use Settings > Assistant > Test the connection.
#
# Any OpenAI-compatible chat service works. Groq example:
#   AI_BASE_URL = "https://api.groq.com/openai/v1"
#   AI_MODEL    = "openai/gpt-oss-120b"
# OpenAI example: leave AI_BASE_URL out and set AI_MODEL to a model your account offers.

AI_API_KEY = ""
AI_MODEL = ""
# AI_BASE_URL = "https://api.groq.com/openai/v1"
