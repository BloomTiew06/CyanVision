{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node web/build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/|app/|logo\\.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
